rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HELPERS
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin') ||
        (request.auth.token.email == "smayansri@gmail.com")
      );
    }

    function ownsPerson(personId) {
      let person = get(/databases/$(database)/documents/people/$(personId)).data;
      return person.get('user_id', '') == request.auth.uid ||
        person.get('host_uid', '') == request.auth.uid ||
        person.get('linked_host_uid', '') == request.auth.uid;
    }

    function ownsContact(contactId) {
      return resource.data.get('user_id', '') == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return isSignedIn() && (
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.get('members', []) ||
        isAdmin()
      );
    }

    function isRoomAdminOrPlanner(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isSignedIn() && (
        ('roles' in room && (room.roles.get(request.auth.uid, 'guest') == 'admin' || room.roles.get(request.auth.uid, 'guest') == 'planner')) ||
        request.auth.uid in room.get('admins', []) ||
        request.auth.uid in room.get('mods', []) ||
        room.get('created_by', '') == request.auth.uid ||
        isAdmin()
      );
    }

    function isResponsesNotLocked(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return !('responses_lock_timestamp' in room) || room.responses_lock_timestamp == null || request.time < room.responses_lock_timestamp;
    }

    // ===============================================================
    // USERS (FIXED FOR PUBLIC LINKS & HANDLE QUERIES)
    // ===============================================================
    match /users/{userId} {
      // Changed to true to let public handle lookup queries resolve cleanly.
      // Your frontend "soft-hide" filters handle hiding blocked users from the UI safely.
      allow get, list: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /coach_messages/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ===============================================================
    // SECRETS
    // ===============================================================
    match /secrets/{secretId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===============================================================
    // CONFIG
    // ===============================================================
    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == "smayansri@gmail.com";
    }

    // ===============================================================
    // SOCIAL ACTIVITY
    // ===============================================================
    match /social_activity/{activityId} {
      allow create: if isSignedIn() && request.resource.data.grabber_uid == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.grabber_uid == request.auth.uid ||
        resource.data.host_uid == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.host_uid == request.auth.uid ||
        resource.data.grabber_uid == request.auth.uid ||
        isAdmin()
      );
    }

    // ===============================================================
    // FRIEND REQUESTS
    // ===============================================================
    match /friend_requests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.sender_uid == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (
        resource.data.sender_uid == request.auth.uid ||
        resource.data.receiver_uid == request.auth.uid ||
        resource.data.get('members', []).hasAny([request.auth.uid]) ||
        isAdmin()
      );
    }

    // ===============================================================
    // PEOPLE
    // ===============================================================
    match /people/{personId} {
      allow read: if isSignedIn() && (resource.data.get('user_id', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.get('user_id', '') == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.get('user_id', '') == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('host_uid', '') == request.auth.uid ||
        resource.data.get('linked_host_uid', '') == request.auth.uid ||
        isAdmin()
      );

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (ownsPerson(personId) || isAdmin());
      }
    }

    // ===============================================================
    // CONTACTS
    // ===============================================================
    match /contacts/{contactId} {
      allow read: if isSignedIn() && (ownsContact(contactId) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.get('user_id', '') == request.auth.uid;
      allow update: if isSignedIn() && (ownsContact(contactId) || isAdmin());
      allow delete: if isSignedIn() && (!exists(/databases/$(database)/documents/contacts/$(contactId)) || ownsContact(contactId) || isAdmin());

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/contacts/$(contactId)).data.get('user_id', '') == request.auth.uid || isAdmin());
      }
    }

    // ===============================================================
    // ROOMS (WITH AI STUDIO SUB-COLLECTION SEGMENTATION)
    // ===============================================================
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.get('members', []) || 
        (!(request.auth.uid in resource.data.get('members', [])) && request.auth.uid in request.resource.data.get('members', [])) ||
        isAdmin()
      ) && (
        !isRoleChanged() || 
        isCurrentRoomAdmin() || 
        (
          (!('roles' in resource.data) && 
           request.resource.data.roles.size() == 1 && 
           request.resource.data.roles.get(request.auth.uid, 'guest') == 'guest') ||
          ('roles' in resource.data && 
           request.resource.data.roles.size() == resource.data.roles.size() + 1 && 
           request.resource.data.roles.get(request.auth.uid, 'guest') == 'guest' &&
           request.resource.data.roles.keys().hasAll(resource.data.roles.keys()))
        )
      ) && isAttendanceRequirementUnchanged() && isAttendanceUnchangedOrSelfOnly();
      allow delete: if isSignedIn() && (resource.data.get('created_by', '') == request.auth.uid || isAdmin());

      function isCurrentRoomAdmin() {
        return isSignedIn() && (
          ('roles' in resource.data && resource.data.roles.get(request.auth.uid, 'guest') == 'admin') ||
          request.auth.uid in resource.data.get('admins', []) ||
          resource.data.get('created_by', '') == request.auth.uid ||
          isAdmin()
        );
      }

      function isRoleChanged() {
        return ('roles' in request.resource.data) && (
          !('roles' in resource.data) || 
          request.resource.data.roles != resource.data.roles
        );
      }

      function isAttendanceRequirementUnchanged() {
        let oldReq = resource.data.get('requires_attendance', false);
        let newReq = request.resource.data.get('requires_attendance', false);
        return oldReq == newReq || isCurrentRoomAdmin();
      }

      function isAttendanceUnchangedOrSelfOnly() {
        let oldAttendance = resource.data.get('attendance', {});
        let newAttendance = request.resource.data.get('attendance', {});
        return oldAttendance == newAttendance || 
               newAttendance.diff(oldAttendance).affectedKeys().hasOnly([request.auth.uid]) ||
               isCurrentRoomAdmin();
      }

      match /surprises/{surpriseId} { allow read: if true; allow write: if isRoomMember(roomId); }
      match /contributions/{contribId} { allow read: if true; allow write: if isRoomMember(roomId); }
      match /ideas/{ideaId} { allow read: if isSignedIn(); allow write: if isRoomMember(roomId); }
       match /chat/{chatId} {
        allow read: if isRoomMember(roomId) && (
          resource.data.get('channel', 'everyone') != 'admin_planner' || 
          isRoomAdminOrPlanner(roomId)
        );
        allow create: if isRoomMember(roomId) && (
          request.resource.data.get('channel', 'everyone') != 'admin_planner' || 
          isRoomAdminOrPlanner(roomId)
        );
        allow update, delete: if isRoomMember(roomId) && isRoomAdminOrPlanner(roomId);
      }
      match /planner_ai_chat/{msgId} {
        allow read, write: if isRoomMember(roomId) && isRoomAdminOrPlanner(roomId);
      }
      match /tasks/{taskId} {
        allow read: if isRoomMember(roomId);
        allow create, delete: if isRoomMember(roomId) && isRoomAdminOrPlanner(roomId);
        allow update: if isRoomMember(roomId) && (
          isRoomAdminOrPlanner(roomId) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed'])
          )
        );
      }
      match /polls/{pollId} { allow read: if isSignedIn(); allow write: if isRoomMember(roomId); }
      match /photos/{photoId} { allow read: if isSignedIn(); allow write: if isRoomMember(roomId); }
      match /party_photos/{photoId} {
        allow read: if isRoomMember(roomId) && (
          isRoomAdminOrPlanner(roomId) || 
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('photo_access', 'guests_can_add') != 'guests_hidden'
        );
        allow create: if isRoomMember(roomId) && (
          isRoomAdminOrPlanner(roomId) || 
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('photo_access', 'guests_can_add') == 'guests_can_add'
        );
        allow update, delete: if isRoomMember(roomId) && (
          isRoomAdminOrPlanner(roomId) || 
          (resource != null && resource.data.get('uploader_id', '') == request.auth.uid)
        );
      }
      match /date_polls/{datePollId} { allow read: if isSignedIn(); allow write: if isRoomMember(roomId); }
      match /themes/{themeId} {
        allow read: if isRoomMember(roomId) && (isRoomAdminOrPlanner(roomId) || (resource != null && resource.data.get('published', false) == true));
        allow create, update, delete: if isRoomMember(roomId) && isRoomAdminOrPlanner(roomId);
      }
      match /venues/{venueId} {
        allow read: if isRoomMember(roomId) && (isRoomAdminOrPlanner(roomId) || (resource != null && resource.data.get('published', false) == true));
        allow create, update, delete: if isRoomMember(roomId) && isRoomAdminOrPlanner(roomId);
      }
      match /playlists/{playlistId} {
        allow read: if isRoomMember(roomId) && (isRoomAdminOrPlanner(roomId) || (resource != null && resource.data.get('published', false) == true));
        allow create, update, delete: if isRoomMember(roomId) && isRoomAdminOrPlanner(roomId);
      }
      match /game_ideas/{gameId} {
        allow read: if isRoomMember(roomId) && (isRoomAdminOrPlanner(roomId) || (resource != null && resource.data.get('published', false) == true));
        allow create, update, delete: if isRoomMember(roomId) && isRoomAdminOrPlanner(roomId);
      }
      match /birthday_questions/{questionId} {
        allow read: if isRoomMember(roomId);
        allow create, update, delete: if isRoomMember(roomId) && isRoomAdminOrPlanner(roomId);
      }
      match /birthday_responses/{responseId} {
        allow read: if isRoomMember(roomId) && (isRoomAdminOrPlanner(roomId) || resource == null || resource.data.user_id == request.auth.uid);
        allow create: if isRoomMember(roomId) && isResponsesNotLocked(roomId) && request.auth.uid != get(/databases/$(database)/documents/rooms/$(roomId)).data.get('recipient_uid', 'celebrant') && request.resource.data.user_id == request.auth.uid;
        allow update: if isRoomMember(roomId) && isResponsesNotLocked(roomId) && resource.data.user_id == request.auth.uid;
        allow delete: if isRoomMember(roomId) && isResponsesNotLocked(roomId) && resource.data.user_id == request.auth.uid;
      }
      match /guest_ai_notes_private/{uid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
      match /guest_ai_notes_neutralized/{uid} {
        allow read: if isRoomMember(roomId);
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ===============================================================
    // SPARK GROUPS (WITH AI STUDIO PERIMETER SECURITY)
    // ===============================================================
    match /spark_groups/{groupId} {
      allow create: if isSignedIn() && request.resource.data.members.hasAny([request.auth.uid]);
      
      allow read: if isSignedIn() && (
        (resource != null && resource.data.get('members', []).hasAny([request.auth.uid])) ||
        isAdmin()
      );
      
      allow update: if isSignedIn() && (
        (resource != null && resource.data.get('members', []).hasAny([request.auth.uid])) ||
        (request.resource != null && request.resource.data.get('members', []).hasAny([request.auth.uid])) ||
        isAdmin()
      );
      
      allow delete: if isSignedIn() && (resource.data.get('created_by', '') == request.auth.uid || isAdmin());

      // Round Management Isolation
      match /rounds/{roundId} {
        allow read, write: if isSignedIn();
        
        match /answers/{answerId} {
          allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
          allow read: if isSignedIn();
          allow update, delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
        }

        match /guesses/{guessId} {
          allow read, write: if isSignedIn();
        }
      }

      // Aura Wallet Protection
      match /aura/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /rematch_pool/{docId} {
        allow read, write: if isSignedIn();
      }

      // Nested Workspace Communication Streams
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (request.resource.data.sender_id == request.auth.uid || request.resource.data.user_id == request.auth.uid);
        allow update, delete: if isSignedIn() && (resource.data.sender_id == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      }

      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (request.resource.data.user_id == request.auth.uid || request.resource.data.creator_id == request.auth.uid);
        allow update, delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.creator_id == request.auth.uid || isAdmin());
      }

      match /stories/{storyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      }
    }

    // ===============================================================
    // NOTIFICATIONS (UNLOCKED FOR CLEAN RECTIVE DELETIONS)
    // ===============================================================
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.get('user_id', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        request.resource.data.get('type', '') != 'group' || (
          request.resource.data.get('user_id', '') != request.auth.uid &&
          request.resource.data.get('link', '').startsWith('/rooms/') &&
          request.resource.data.get('room_id', '') != '' &&
          isRoomMember(request.resource.data.get('room_id', ''))
        )
      );
      allow update: if isSignedIn() && (resource.data.get('user_id', '') == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (
        !exists(/databases/$(database)/documents/notifications/$(notifId)) ||
        resource.data.get('user_id', '') == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
